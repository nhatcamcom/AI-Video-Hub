# Sao chép file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
# Mọi biến đều có thể đặt trực tiếp bằng biến môi trường (tên không phân biệt hoa/thường).

# development | test | staging | production
APP_ENV=development

# Không bao giờ bật DEBUG trên production (app sẽ từ chối khởi động)
DEBUG=false

# Bắt buộc. SQLite cho dev; khi mở rộng đổi sang PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_video_hub
DATABASE_URL=sqlite+aiosqlite:///./ai_video_hub.db

# Danh sách origin được gọi API từ trình duyệt — định dạng JSON.
# Không dùng "*" khi ALLOW_CREDENTIALS=true (app sẽ từ chối khởi động).
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ALLOW_CREDENTIALS=true

# URL gốc người dùng truy cập — dùng để dựng link trong email (đặt lại mật khẩu…)
# Staging/production BẮT BUỘC https://
PUBLIC_BASE_URL=http://localhost:8000

# --- Reverse proxy ---
# Để trống [] khi KHÔNG có reverse proxy: X-Forwarded-For bị bỏ qua hoàn toàn.
# Có proxy (nginx, Caddy, load balancer…): khai báo ĐÚNG IP/CIDR của proxy, ví dụ ["10.0.0.5"].
# Wildcard ("*", 0.0.0.0/0, ::/0) và dải công khai quá rộng (rộng hơn /8 với IPv4, /32 với IPv6)
# bị từ chối. Luôn chạy server bằng: python -m app.server
TRUSTED_PROXY_IPS=[]

# --- Phiên đăng nhập ---
# Thời hạn phiên (giờ), 1–720
SESSION_TTL_HOURS=168
# Chỉ gửi cookie qua HTTPS. Dev (http://localhost) để false; staging/production BẮT BUỘC true.
# Khi true, cookie phiên tự đổi tên thành __Host-avh_session (subdomain không ghi đè được).
COOKIE_SECURE=false
# Trình duyệt đã đăng nhập thành công nhận cookie "thiết bị quen" (ngày, 1–365): có ngân sách đăng
# nhập riêng nên kẻ tấn công không khóa được chủ tài khoản trên trình duyệt đó
TRUSTED_DEVICE_TTL_DAYS=30

# --- Đặt lại mật khẩu & email ---
# Thời hạn token đặt lại mật khẩu (phút), 5–60
PASSWORD_RESET_TTL_MINUTES=30
# file     : ghi email ra thư mục EMAIL_OUTBOX_DIR (chỉ dev — file chứa cả token reset)
# memory   : giữ trong RAM (test)
# disabled : không gửi (staging/production BẮT BUỘC cho tới khi tích hợp nhà cung cấp email thật)
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=storage/dev-outbox

# --- Lưu trữ file người dùng ---
# Thư mục gốc chứa uploads/, videos/, posters/, tmp/ (tạo khi ghi file đầu tiên). Đường dẫn tương
# đối tính từ thư mục dự án. KHÔNG được nằm trong hoặc bao trùm static/ hay app/ (app từ chối khởi động).
STORAGE_ROOT=storage
# Hạn mức mỗi user, tính theo byte thực ghi xuống đĩa. 1073741824 = 1 GiB
STORAGE_QUOTA_BYTES_PER_USER=1073741824

# --- Upload ảnh (P2-4) ---
# Ảnh tối đa (byte THỰC đọc được, cả file gốc lẫn file sau khi mã hóa lại). 10485760 = 10 MiB
IMAGE_UPLOAD_MAX_BYTES=10485760
# Giới hạn body của MỌI request (đếm byte thật, kể cả khi Content-Length khai sai); phải lớn hơn
# IMAGE_UPLOAD_MAX_BYTES để chừa overhead multipart. 11534336 = 11 MiB. Vượt → 413 payload_too_large
MAX_REQUEST_BODY_BYTES=11534336

# --- Model video (P2-5) ---
# Key model đang bật, theo thứ tự hiển thị (JSON). Phase 2 chỉ có "mock": bản DEMO, KHÔNG phải AI
# thật, ở mọi môi trường. Danh sách rỗng, key trùng, sai định dạng hoặc không tồn tại → app không
# khởi động. Key là định danh bất biến (được lưu cùng mỗi video), không đổi tên.
ENABLED_VIDEO_MODELS=["mock"]

# --- Worker tạo video (P2-7) — chạy riêng: python -m app.worker ---
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
# Phải nhỏ hơn WORKER_LEASE_SECONDS / 2
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_ATTEMPTS=3
# Backoff khi thử lại = giá trị này nhân với số lần đã thử
WORKER_RETRY_BACKOFF_SECONDS=15
# Chờ job đang chạy khi nhận tín hiệu dừng; quá hạn → hủy job theo giai đoạn
WORKER_SHUTDOWN_GRACE_SECONDS=30

# --- Dừng an toàn (web + worker) ---
# Chờ task dọn dẹp nền; còn task → hủy rồi chờ thêm. Vẫn còn task → KHÔNG dispose engine (log critical).
# Đây chỉ là thời hạn của các bước này, KHÔNG phải tổng thời gian tiến trình kết thúc.
SHUTDOWN_DRAIN_SECONDS=10
SHUTDOWN_CANCEL_GRACE_SECONDS=5
# uvicorn hủy request còn treo sau thời gian này khi tắt server
SERVER_GRACEFUL_SHUTDOWN_SECONDS=20

# --- Mock provider (P2-7) — bản DEMO, KHÔNG phải AI thật ---
# File MP4 mẫu do chủ dự án cung cấp (không commit, ví dụ trong storage/). Trống / thiếu file →
# job thất bại với mock_sample_missing; app và worker vẫn khởi động bình thường.
MOCK_SAMPLE_VIDEO_PATH=
MOCK_PROCESSING_SECONDS=5
# Chỉ để thử giao diện lỗi; bị từ chối khi APP_ENV=production
MOCK_FORCE_FAILURE=false
# 104857600 = 100 MiB
VIDEO_OUTPUT_MAX_BYTES=104857600

# --- Giới hạn truy cập (login, register, forgot/reset password) ---
# Staging/production BẮT BUỘC true
RATE_LIMIT_ENABLED=true
# Giới hạn theo IP/mạng (in-memory): tổng số bộ đếm tối đa (100–1.000.000, ~1,1 KB mỗi bộ đếm),
# chia riêng cho từng rule. IPv4 và mạng IPv6 /48 hết chỗ → client MỚI nhận 429 (fail-closed).
RATE_LIMIT_MAX_KEYS=100000
# Giới hạn theo tài khoản (trong database) dùng HMAC của email với khóa này. Staging/production
# BẮT BUỘC, ≥ 32 ký tự, GIỐNG NHAU giữa mọi worker. Dev để trống = khóa ngẫu nhiên mỗi tiến trình.
# Tạo khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_THROTTLE_KEY=
